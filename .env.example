APP_NAME=Sentria
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sentria
DB_USERNAME=sentria
DB_PASSWORD=sentria

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
# Production (HTTPS): set SESSION_SECURE_COOKIE=true and consider SESSION_SAME_SITE=strict
# for stricter CSRF protection on cross-site requests. Keep lax for local HTTP dev.
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=mailtrap-sdk
MAILTRAP_HOST=sandbox.api.mailtrap.io
MAILTRAP_API_KEY=
MAILTRAP_INBOX_ID=
MAIL_FROM_ADDRESS="no-reply@sentria.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Real-time (Laravel Reverb) ---------------------------------------------
REVERB_APP_ID=sentria
REVERB_APP_KEY=sentria-local-key
REVERB_APP_SECRET=sentria-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Sentria: organization ---------------------------------------------------
# Single-LGU deployment. No multi-tenancy.
SENTRIA_ORG_NAME="Sangguniang Bayan"
SENTRIA_ORG_SHORT_NAME="SB"
SENTRIA_ORG_LOCALITY="Municipality of Demo"

# --- Sentria: AI providers (swappable, never exposed to the frontend) --------
# AI assists personnel. It never decides, votes, finalizes, or publishes.
AI_ENABLED=true
AI_PROVIDER=openai
AI_BASE_URL=https://api.xkiro.com/v1
AI_API_KEY=
AI_CHAT_MODEL=qwen/qwen3.5-flash:free
# OpenAI: text-embedding-3-small. Gemini (AI_BASE_URL=.../v1beta/openai): gemini-embedding-001.
# Optional separate embedding host/key when chat and embeddings use different providers.
# AI_EMBEDDING_BASE_URL=
# AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
# Leave unset to send OpenAI `dimensions` only for text-embedding-3-* models.
# AI_EMBEDDING_SEND_DIMENSIONS=

# Scanned PDFs need tesseract (+ Poppler pdftoppm). Use null only when those binaries are unavailable.
OCR_DRIVER=tesseract
OCR_TESSERACT_BIN=/usr/bin/tesseract
OCR_PDFTOPPM_BIN=/usr/bin/pdftoppm

# Speech-to-text. Independent of AI chat. Official votes never come from STT.
# Single driver: whisper | qwen3 | elevenlabs | fake | null
# Failover chain (first healthy wins): qwen3,elevenlabs,whisper
# TRANSCRIPTION_DRIVER=failover uses TRANSCRIPTION_FAILOVER for the order.
TRANSCRIPTION_DRIVER=null
TRANSCRIPTION_FAILOVER=qwen3,whisper
TRANSCRIPTION_FAILOVER_FAILURES=3
TRANSCRIPTION_FAILOVER_COOLDOWN=60
TRANSCRIPTION_LANGUAGE_MODE=auto

# Local Qwen3-ASR (OpenAI-compatible /audio/transcriptions). Short timeout so a down GPU fails over fast.
TRANSCRIPTION_QWEN3_BASE_URL=http://127.0.0.1:8000/v1
TRANSCRIPTION_QWEN3_API_KEY=local
TRANSCRIPTION_QWEN3_MODEL=Qwen/Qwen3-ASR-1.7B
TRANSCRIPTION_QWEN3_TIMEOUT=15
TRANSCRIPTION_QWEN3_CONNECT_TIMEOUT=2

# Cloud Whisper-compatible (Groq). Do not use Groq's /audio/translations endpoint (it forces English).
# https://console.groq.com/keys — whisper-large-v3 (accuracy) or whisper-large-v3-turbo (cheaper).
TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
TRANSCRIPTION_TIMEOUT=120
TRANSCRIPTION_CONNECT_TIMEOUT=5

# Optional ElevenLabs Scribe v2 (cloud). DPO review required — chamber audio leaves the LGU.
# Keyterms add cost; leave false unless you need agenda-term bias.
TRANSCRIPTION_ELEVENLABS_BASE_URL=https://api.elevenlabs.io
TRANSCRIPTION_ELEVENLABS_API_KEY=
TRANSCRIPTION_ELEVENLABS_MODEL=scribe_v2
TRANSCRIPTION_ELEVENLABS_TIMEOUT=120
TRANSCRIPTION_ELEVENLABS_KEYTERMS=false
# File-upload only: Scribe diarization (Speaker 0/1) and [sniffs]-style events.
# Live chamber chunks keep diarization off — the seat mic already names the speaker.
TRANSCRIPTION_ELEVENLABS_DIARIZE_UPLOAD=true
TRANSCRIPTION_ELEVENLABS_AUDIO_EVENTS_UPLOAD=true
# Segments below this confidence (0–1) are marked unverified in the transcript UI.
TRANSCRIPTION_LOW_CONFIDENCE=0.4

# Chamber per-seat capture (dedicated mics → one multi-channel interface)
CHAMBER_CAPTURE_EMAIL=chamber-capture@sentria.local
CHAMBER_DEFAULT_CAPTURE_MODE=mixer_mix
CHAMBER_AUDIO_RETENTION_DAYS=30
CHAMBER_MIN_CHUNK_BYTES=2048
CHAMBER_MIN_DURATION_MS=400

# --- Sentria: document intake security --------------------------------------
# Development uses the no-op scanner; production must use clamav or equivalent.
MALWARE_SCANNER=null
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl

# Historical legislation import. PHP post_max_size must be larger than zip + csv.
# SENTRIA_IMPORT_ZIP_MAX_KB=204800
# SENTRIA_IMPORT_CSV_MAX_KB=2048

# --- Sentria: session security (production) -----------------------------------
# When served over HTTPS, set SESSION_SECURE_COOKIE=true so session cookies are
# not sent over plain HTTP. SESSION_SAME_SITE=lax is the default; use strict for
# tighter cross-site cookie policy when all flows are same-site.

# --- Sentria: electronic signatures (architecture stub — slice 5b) ------------
# Image uploads are acknowledgements only, NOT legally valid digital signatures.
SENTRIA_ELECTRONIC_SIGNATURES_ENABLED=false
SENTRIA_ELECTRONIC_SIGNATURES_DRIVER=none
SENTRIA_REQUIRE_WET_SIGNATURE=true
